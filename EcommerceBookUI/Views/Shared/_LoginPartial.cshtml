@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    <li class="nav-item">
        <a class="nav-link" href="/Cart/GetUserCart">
            <span id="cartCount" class="badge text-bg-info">0</span><!-- ymodifiha fl cartcontroller elli ynedi lel index.html js part -->
            <i class="bi bi-cart text-white"></i>
        </a>
    </li>

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Hello <span id="username">@User.Identity?.Name</span>!
                @if (User.IsInRole("Admin"))
                {
                    <span>(Admin)</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {

        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }<!--just added by me -->
</ul>

@if (SignInManager.IsSignedIn(User))
{
    <script>
        
        (async function(){
            try {
                const r = await fetch('/Cart/GetTotalItemInCart');
                if (r.ok) {
                    const count = await r.text();
                    const el = document.getElementById('cartCount');
                    if (el) el.innerHTML = count;
                }
            } catch (e) {
                console.debug('Could not refresh cart count', e);
            }
        })();
    </script>
}